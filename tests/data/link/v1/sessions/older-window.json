{
    "runs": ["station"],
    "stationSetup": {"radio": "static", "slices": 1, "otherPairedDevices": 4, "otherClients": [{"name": "a", "device": 1, "features": {"deviceAuth": 1, "sessionHolder": 1}}, {"name": "b", "device": 2, "features": {"deviceAuth": 1, "sessionHolder": 1}}, {"name": "c", "device": 3, "features": {"deviceAuth": 1, "sessionHolder": 1}}, {"name": "d", "device": 4, "features": {"deviceAuth": 1, "sessionHolder": 1}}]},
    "steps": [
        {"from": "station", "message": {"challenge": "$string", "features": {"deviceAuth": 1, "pairing": 1, "sessionHolder": 1}, "identity": {"certBinding": "$string", "publicKey": "$string"}, "major": 1, "majors": [1], "minor": 11, "peer": "nereusd", "settingsSchema": 0, "type": "hello"}},
        {"connect": "a"},
        {"connect": "b"},
        {"connect": "c"},
        {"connect": "d"},
        {"from": "client", "role": "scripted", "message": {"type": "hello", "major": 1, "minor": 11, "settingsSchema": 0, "peer": "NereusSDR"}},
        {"from": "client", "role": "scripted", "message": {"type": "auth.request", "token": "$ref:token"}},
        {"from": "station", "message": {"accepted": true, "reason": "", "retryable": false, "type": "auth.result"}},
        {"from": "station", "message": {"reason": "The Core already has four devices connected.", "retryable": true, "type": "session.end"}},
        {"expectClosed": {"retryable": true}}
    ]
}
