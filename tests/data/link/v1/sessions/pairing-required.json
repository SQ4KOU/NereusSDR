{
    "runs": ["station"],
    "stationSetup": {"radio": "static", "slices": 1, "token": "none"},
    "steps": [
        {"from": "station", "message": {"challenge": "$capture:challenge", "features": {"deviceAuth": 1}, "identity": {"certBinding": "$string", "publicKey": "$string"}, "major": 1, "majors": [1], "minor": 11, "peer": "nereusd", "settingsSchema": 0, "type": "hello"}},
        {"from": "client", "role": "scripted", "message": {"type": "hello", "major": 1, "minor": 11, "settingsSchema": 0, "peer": "NereusSDR"}},
        {"from": "client", "role": "scripted", "message": {"type": "auth.request", "token": "not-a-station-token"}},
        {"from": "station", "message": {"accepted": false, "code": "pairingRequired", "reason": "This Core uses paired devices. Pair this device first.", "retryable": false, "type": "auth.result"}},
        {"expectClosed": {"retryable": false}}
    ]
}
