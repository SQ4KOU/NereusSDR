# systemd unit for the NereusSDR rendezvous service.
#
# Installed as /etc/systemd/system/nereus-rendezvous.service by
# rendezvous/deploy/setup-server.sh. The code lives in /opt/nereus-rendezvous
# (put there by rendezvous/deploy.sh), the configuration in
# /etc/nereus-rendezvous/rendezvous.conf and the TURN secret in
# /etc/nereus-rendezvous/turn-secret (both written by setup-server.sh).
# The wire is docs/architecture/2026-09-23-rendezvous-v1.md.

[Unit]
Description=NereusSDR rendezvous service
Documentation=https://github.com/boydsoftprez/NereusSDR/tree/main/rendezvous
After=network.target

[Service]
Type=exec
# Ubuntu's own python3 with its python3-websockets and python3-cryptography;
# nothing from pip.
ExecStart=/usr/bin/python3 -m nereus_rendezvous --config /etc/nereus-rendezvous/rendezvous.conf
Environment=PYTHONPATH=/opt/nereus-rendezvous
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/
Restart=on-failure
RestartSec=5
# SIGTERM makes the service tell every connection it is going
# (shuttingDown) and close them. On Python 3.12 with Ubuntu's websockets
# 10.4 that takes up to about 11 s (a 5 s close handshake after a wait of
# up to 5 s for each writer), so the stop timeout sits well above it.
KillSignal=SIGTERM
TimeoutStopSec=20

# --- The TURN secret ----------------------------------------------------
# systemd copies the root-only secret file to
# /run/credentials/nereus-rendezvous.service/turn-secret, readable by this
# service alone, and rendezvous.conf's turn_secret_file points there.
LoadCredential=turn-secret:/etc/nereus-rendezvous/turn-secret

# --- Identity -----------------------------------------------------------
# A transient account made for each run; the service owns no files.
DynamicUser=yes
User=nereus-rendezvous
Group=nereus-rendezvous

# --- Network ------------------------------------------------------------
# The service listens on loopback only (127.0.0.1 and ::1, port 8710 by
# default); Caddy on the same host is its only peer. It makes no outgoing
# connection, so nothing else is allowed.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- Memory -------------------------------------------------------------
# The worst case the rendezvous document section 9.1 works out for the
# default limits, kernel socket buffers included, is about 309 MiB. This
# ceiling sits just above it, so it never ends the service at the
# configured limits, and it keeps anything unforeseen from taking memory
# the website and the relay need on a 1 GB server. Socket buffers are
# charged to this unit too (cgroup v2); their size per connection is set by
# the service itself (socket_buffer_bytes), not by any host setting.
MemoryMax=320M
MemorySwapMax=0
TasksMax=64

# --- Sandboxing ---------------------------------------------------------
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# Not set, because no systemd was at hand to prove them against Python,
# OpenSSL and libffi (cryptography's callbacks): MemoryDenyWriteExecute= and
# SystemCallFilter=. Candidates once `systemd-analyze security
# nereus-rendezvous` and a full check have run on the server.

[Install]
WantedBy=multi-user.target
