 #include "udp.h"
 #include "addr.h"
 #include "log.h"
@@ -42,6 +46,84 @@
 	uint16_t next = begin + count++ % (diff + 1);
 	mutex_unlock(&mutex);
 	return next;
+}
+
+#if defined(__APPLE__)
+// On macOS a dual-stack socket (IPv6 wildcard, IPV6_V6ONLY off) can bind a
+// port that another socket already holds as an IPv4-only wildcard socket,
+// the system-picked port of a port 0 bind included. IPv4 datagrams to that
+// port then reach the other socket, so ICE checks over IPv4 never arrive.
+// The reverse order is refused: once a dual-stack socket holds a port, an
+// IPv4 bind on it fails with EADDRINUSE. So the IPv4 port is taken first,
+// the dual-stack socket binds onto it, and the IPv4 hold is then released.
+#define DUAL_STACK_PICK_ATTEMPTS 16
+
+static socket_t hold_ipv4_port(uint16_t port, uint16_t *held_port) {
+	socket_t hold = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (hold == INVALID_SOCKET)
+		return INVALID_SOCKET;
+
+	struct sockaddr_in sin;
+	memset(&sin, 0, sizeof(sin));
+	sin.sin_len = sizeof(sin);
+	sin.sin_family = AF_INET;
+	sin.sin_addr.s_addr = htonl(INADDR_ANY);
+	sin.sin_port = htons(port);
+	if (bind(hold, (struct sockaddr *)&sin, sizeof(sin)) != 0) {
+		int err = sockerrno;
+		closesocket(hold);
+		errno = err;
+		return INVALID_SOCKET;
+	}
+
+	*held_port = udp_get_port(hold);
+	return hold;
+}
+
+static int bind_dual_stack(socket_t sock, struct sockaddr *addr, socklen_t addrlen) {
+	const uint16_t wanted = addr_get_port(addr);
+	const int attempts = wanted == 0 ? DUAL_STACK_PICK_ATTEMPTS : 1;
+	int err = SEADDRINUSE;
+	for (int i = 0; i < attempts; ++i) {
+		uint16_t port = 0;
+		socket_t hold = hold_ipv4_port(wanted, &port);
+		if (hold == INVALID_SOCKET) {
+			// A port taken for IPv4 is in use for this socket too
+			if (sockerrno == SEADDRINUSE || sockerrno == SEACCES)
+				return -1;
+
+			// No IPv4 here, nothing to collide with
+			JLOG_DEBUG("No IPv4 port hold, errno=%d", sockerrno);
+			addr_set_port(addr, wanted);
+			return bind(sock, addr, addrlen);
+		}
+
+		addr_set_port(addr, port);
+		int ret = bind(sock, addr, addrlen);
+		err = sockerrno;
+		closesocket(hold);
+		if (ret == 0)
+			return 0;
+
+		if (wanted != 0 || err != SEADDRINUSE)
+			break;
+
+		JLOG_DEBUG("UDP port %hu is free for IPv4 only, picking another", port);
+	}
+
+	// Set last, so that no call above changes it
+	addr_set_port(addr, wanted);
+	errno = err;
+	return -1;
+}
+#endif
+
+static int bind_socket(socket_t sock, struct sockaddr *addr, socklen_t addrlen) {
+#if defined(__APPLE__)
+	if (addr->sa_family == AF_INET6 && addr_is_any(addr))
+		return bind_dual_stack(sock, addr, addrlen);
+#endif
+	return bind(sock, addr, addrlen);
 }
 
