--- a/src/impl/sctptransport.cpp
+++ b/src/impl/sctptransport.cpp
@@ -61,6 +61,17 @@ static LogCounter COUNTER_UNKNOWN_PPID(plog::warning,
 
 class SctpTransport::InstancesSet {
 public:
+	// NereusSDR: with MinGW-w64, std::shared_mutex is a pthread rwlock that
+	// winpthreads sets up on its first lock, and a thread that loses that race
+	// gets EINVAL, which libstdc++ checks only under _GLIBCXX_ASSERTIONS, and
+	// goes on without the lock. Two transports made at the same moment then
+	// change mSet together, and a transport lost from it never sends or
+	// receives. Lock once here, while no other thread can see the set.
+	InstancesSet() {
+		mMutex.lock();
+		mMutex.unlock();
+	}
+
 	void insert(SctpTransport *instance) {
 		std::unique_lock lock(mMutex);
 		mSet.insert(instance);
