# NereusSDR-native, verified and repeatable patches for pinned Opus 940d4e5.
# Preserve the MSVC-safe visibility header and upstream RADE v2 scratch patch.
cmake_minimum_required(VERSION 3.16)
if(NOT SOURCE_DIR OR NOT PATCH_EXECUTABLE)
    message(FATAL_ERROR "Opus patches require SOURCE_DIR and PATCH_EXECUTABLE")
endif()
set(_extensions h c)
set(_before_h c8f3e0fae0d9bb0a17a09ffb96bf924e81d7d75f9547e5b1a2bd0cd2d58d0dd9)
set(_after_h 03e9864f07dbab0a2d0a6599187f5a8b4e5c4e250631357f40fa80f828527cb3)
set(_before_c b5825c352a2a8aca70d55603e97f9d7a1a60fc76b2d98c77ff7ebfc733b07e05)
set(_after_c 52544d64705c36ecf3a096c4b929c4dcd7547a342c227fbec071456f2acf7bee)
# Check both inputs before changing either: local or unknown source is an error.
foreach(_extension IN LISTS _extensions)
    set(_file "${SOURCE_DIR}/dnn/nnet.${_extension}")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "Missing pinned Opus source: ${_file}")
    endif()
    file(SHA256 "${_file}" _hash)
    if(_hash STREQUAL _after_${_extension})
        set(_apply_${_extension} FALSE)
    elseif(_hash STREQUAL _before_${_extension})
        set(_apply_${_extension} TRUE)
    else()
        message(FATAL_ERROR "Unexpected Opus source ${_file} (${_hash}); expected pinned pristine or RADE-patched source")
    endif()
endforeach()
foreach(_extension IN LISTS _extensions)
    if(_apply_${_extension})
        execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --forward
            "${SOURCE_DIR}/dnn/nnet.${_extension}" -i
            "${CMAKE_CURRENT_LIST_DIR}/../src/opus-nnet.${_extension}.diff"
            RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
        if(NOT _result EQUAL 0)
            message(FATAL_ERROR "Opus nnet.${_extension} patch failed: ${_output}${_error}")
        endif()
        file(SHA256 "${SOURCE_DIR}/dnn/nnet.${_extension}" _hash)
        if(NOT _hash STREQUAL _after_${_extension})
            message(FATAL_ERROR "Opus nnet.${_extension} patch produced an unexpected source hash: ${_hash}")
        endif()
    endif()
endforeach()
