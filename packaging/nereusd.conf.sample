# NereusSDR headless daemon (nereusd) configuration.
#
# Format: key = value, one per line. '#' starts a comment, whether it is
# the whole line (like this one) or trails a value on the same line.
# Leading and trailing whitespace around both the key and the value is
# trimmed. Blank lines are ignored. Unknown keys are logged as a warning
# but do not stop the daemon, so a config file written for a newer nereusd
# still starts an older one.
#
# Default location: /etc/nereusd.conf. Override with nereusd --config <path>.
# See src/core/daemon/DaemonConfig.{h,cpp} for the parser this file feeds.
#
# Running more than one nereusd against different radios on the same
# machine (or testing nereusd on a workstation that also runs the GUI
# client) needs its own settings/log directory per instance: pass
# nereusd --profile <name> (name must match [A-Za-z0-9_-]+) to keep this
# instance's AppSettings store and log files out of the shared default
# directory. See nereusd --help for the full option list.

# MAC address of the radio to connect to, colon-separated hex
# (e.g. 00:1C:2D:05:37:2A). Leave unset to connect to the first radio
# nereusd discovers on the network.
# Default: (unset -- first discovered)
radio_mac =

# Hardware I/Q sample rate in Hz. Must be a rate the connected board
# actually supports; see docs/protocols/openhpsdr-protocol2.md.
# Default: 192000
sample_rate_hz = 192000

# Number of receive slices to bring up. Must be at least 1; further
# clamped to the connected board's own maximum (2 to 5 depending on SKU)
# once a radio is discovered.
# Default: 1
slice_count = 1

# Local audio output device name, for monitoring on a Pi with a sound
# card attached. Leave unset to use the platform default output device.
# A headless Pi with no sound card is a supported configuration: opening
# the device fails harmlessly, is logged, and the daemon keeps running
# and demodulating with no local monitoring.
# Default: (unset -- platform default)
audio_device =

# TCP port for the remote-control (wss) listener a NereusSDR GUI connects
# to with --station wss://<host>:<port>. 0 disables the listener entirely,
# which is the default: nothing needs it until you ask for it, and a daemon
# that binds a port on first install with a pairing token buried in a log
# is a worse default than one line of config here.
#
# The FIRST time the listener starts, nereusd generates a pairing token and
# a self-signed TLS certificate and prints both, once, to its log. Copy them
# to the client: the token authenticates you, and the certificate SHA-256
# fingerprint is what the client pins. They are stored under the daemon's
# own profile directory alongside the settings file.
# Default: 0 (disabled)
remote_port = 0

# Address the remote-control listener binds. Defaults to loopback, so out
# of the box the listener is reachable only from this machine even once
# remote_port is set. Use 0.0.0.0 (or a specific interface address) to
# accept connections from other machines, and note that doing so is the
# moment to think about who can reach this port.
# Default: 127.0.0.1
remote_bind = 127.0.0.1

# Name shown under LAN Cores in the GUI Connections window. Empty uses this
# machine's hostname. At most 128 UTF-8 bytes, without control characters.
# An available non-loopback remote listener announces its certificate identity,
# name and radio availability on local-link multicast UDP 47910 every 5 seconds.
# It never announces a token; the GUI still requires saved/verified credentials.
core_name =

# Optional measured display limits. Set BOTH keys to positive integers after
# measuring this Core host and link; no universal capacity is assumed here.
# Application bytes include spectrum and PureSignal display messages, but not
# Opus audio, control, encryption or network overhead. Spectrum sample units
# count the independent trace, waterfall and optional wide plane; not FFT CPU.
# Omitting both preserves legacy display behavior. A partial/invalid pair is
# a startup error. Examples use placeholders deliberately, not suggested rates:
# display_application_bytes_per_second = <measured bytes per second>
# spectrum_sample_units_per_second = <measured spectrum samples per second>

# Logging verbosity is NOT set here. Use Qt's own QT_LOGGING_RULES
# environment variable, which takes precedence over the filter rules
# NereusSDR installs at startup, and which systemd can set for you:
#
#   [Service]
#   Environment=QT_LOGGING_RULES=nereus.*.debug=true
#
# Category names are the nereus.* ids in src/core/LogCategories.cpp
# (nereus.connection, nereus.audio, nereus.dsp, ...); nereus.* matches
# all of them.
