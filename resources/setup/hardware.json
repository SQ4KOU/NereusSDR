      "id": "hardware.antennaAlex",
      "title": "Antenna / ALEX",
      "where": "station",
      "coverage": "partial",
      "sections": [
        {
          "title": "Antenna Control",
          "controls": [
            {
              "id": "hardware.antennaAlex.blockTxAnt2",
              "label": "Block TX on Ant 2",
              "tooltip": "Prevents transmit assignments to Antenna Port 2. Use when Ant 2 is wired for receive only.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "blockTxAnt2"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 6, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.blockTxAnt3",
              "label": "Block TX on Ant 3",
              "tooltip": "Prevents transmit assignments to Antenna Port 3. Use when Ant 3 is wired for receive only.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "blockTxAnt3"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 6, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.rxOutOnTx",
              "label": "RX Bypass on TX",
              "tooltip": "Enable RX Bypass Out relay on transmit.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "rxOutOnTx"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 5, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.ext1OutOnTx",
              "label": "Ext 1 on Tx",
              "tooltip": "Route Ext 1 to receive path during transmit.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "ext1OutOnTx"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 6, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.ext2OutOnTx",
              "label": "Ext 2 on Tx",
              "tooltip": "Enable RX 1 IN on Alex or Ext 2 on ANAN during transmit.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "ext2OutOnTx"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 6, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.rxOutOverride",
              "label": "Disable RX Bypass relay",
              "tooltip": "Disable the RX Bypass Out relay (chkDisableRXOut in Thetis).",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "rxOutOverride"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 6, "offAir": true}
            },
            {
              "id": "hardware.antennaAlex.useTxAntennaForRx",
              "label": "Use TX antenna for RX",
              "tooltip": "Use the TX antenna for RX instead of the RX antenna.",
              "kind": "toggle",
              "binding": {"property": {"object": "alexAntennas", "name": "useTxAntennaForRx"}},
              "applies": "live",
              "gate": {"capability": "radioHardwareVersion", "min": 2}
            }
          ]
        }
      ]
