              "id": "catNetwork.tciServer.coreExpert",
              "label": "Emulate ExpertSDR3 protocol",
              "tooltip": "",
              "kind": "toggle",
              "binding": {
                "command": {
                  "verb": "setStationTciOptions",
                  "valueProperty": {
                    "object": "stationTci",
                    "name": "emulateExpertSdr3"
                  },
                  "arguments": {
                    "emulateExpertSdr3": {
                      "$controlValue": true
                    },
                    "emulateSunSdr2Pro": {
                      "$property": {
                        "object": "stationTci",
                        "name": "emulateSunSdr2Pro"
                      }
                    },
                    "cwluBecomesCw": {
                      "$property": {
                        "object": "stationTci",
                        "name": "cwluBecomesCw"
                      }
                    },
                    "sendInitialState": {
                      "$property": {
                        "object": "stationTci",
                        "name": "sendInitialState"
                      }
                    }
                  }
                }
              },
              "applies": "live",
              "gate": {
                "capability": "stationTciVersion",
                "min": 2
              }
            },
