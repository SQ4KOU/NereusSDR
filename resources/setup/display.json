{
  "version": 11,
  "category": {
    "id": "display",
    "title": "Display",
    "where": "mixed",
    "coverage": "partial"
  },
  "pages": [
    {
      "id": "display.spectrumDefaults",
      "title": "Spectrum Defaults",
      "where": "mixed",
      "coverage": "partial",
      "sections": [
        {
          "title": "Fast Fourier Transform",
          "controls": [
            {
              "id": "display.spectrumDefaults.fftSize",
              "label": "Size",
              "tooltip": "FFT size used for spectrum analysis. Range 4096 to 262144 in powers of two. Larger = finer frequency resolution and a smaller bin width, at higher CPU cost.",
              "kind": "slider",
              "binding": {
                "setting": "DisplayFftSize"
              },
              "applies": "subscription",
              "requiresDescriptionVersion": 4,
              "options": [
                {
                  "value": 4096,
                  "label": "4096"
                },
                {
                  "value": 8192,
                  "label": "8192"
                },
                {
                  "value": 16384,
                  "label": "16384"
                },
                {
                  "value": 32768,
                  "label": "32768"
                },
                {
                  "value": 65536,
                  "label": "65536"
                },
                {
                  "value": 131072,
                  "label": "131072"
                },
                {
                  "value": 262144,
                  "label": "262144"
                }
              ],
              "default": 4096
            },
            {
              "id": "display.spectrumDefaults.window",
              "label": "Window",
              "tooltip": "FFT window function. Rectangular has the narrowest main lobe but the worst sidelobes. Blackman-Harris (4T or 7T) gives strong sidelobe rejection. Flat-Top is best for amplitude calibration. Kaiser is parameterized (Kaiser Pi shape parameter).",
              "kind": "choice",
              "binding": {
                "setting": "DisplayFftWindow"
              },
              "applies": "subscription",
              "choices": [
                "Rectangular",
                "Blackman-Harris 4T",
                "Hann",
                "Flat-Top",
                "Hamming",
                "Kaiser",
                "Blackman-Harris 7T"
              ],
              "default": 1
            },
            {
              "id": "display.spectrumDefaults.hzPerBinTarget",
              "label": "Hz/bin Target",
              "tooltip": "Auto-zoom override: target a constant Hz/bin regardless of zoom. Set to 0 (\"Off\") to use the default bins-in-window behavior (FFT replans on zoom). When > 0, the FFT size is fixed at sample rate / target so the trace delivers the requested resolution at any zoom level, which is handy for hunting narrow signals (CW, digital). Floor at the FFT slider value still applies (slider sets the minimum FFT size).",
              "kind": "decimal",
              "binding": {
                "setting": "DisplayHzPerBinTarget"
              },
              "applies": "subscription",
              "min": 0,
              "max": 200,
              "step": 0.5,
              "decimals": 2,
              "unit": "Hz/bin",
              "default": 0
            }
          ]
        },
        {
          "title": "Rendering",
          "controls": [
            {
              "id": "display.spectrumDefaults.fps",
              "label": "FPS:",
              "tooltip": "Spectrum/waterfall redraw rate. Higher = smoother animation at cost of CPU.",
              "kind": "slider",
              "binding": {
                "setting": "DisplaySpectrumFps"
              },
              "applies": "subscription",
              "min": 10,
              "max": 60,
              "step": 1,
              "unit": "fps",
              "default": 30
            },
            {
              "id": "display.spectrumDefaults.detector",
              "label": "Spectrum Detector:",
              "tooltip": "Spectrum bin-reduction policy. Peak takes the maximum bin in each display pixel. Rosenfell alternates max/min for a classic spectrum look. Average takes the arithmetic mean. Sample takes the first bin. RMS computes root-mean-square power.",
              "kind": "choice",
              "binding": {"phone": "DisplaySpectrumDetector"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "options": [
                {"value": 0, "label": "Peak"},
                {"value": 1, "label": "Rosenfell"},
                {"value": 2, "label": "Average"},
                {"value": 3, "label": "Sample"},
                {"value": 4, "label": "RMS"}
              ],
              "default": 0,
              "gate": {"capability": "remoteMediaVersion", "min": 1}
            },
            {
              "id": "display.spectrumDefaults.averaging",
              "label": "Spectrum Averaging:",
              "tooltip": "Spectrum frame-averaging mode. None shows raw FFT output per frame. Recursive exponentially smooths in linear power space. Time Window approximates a sliding average. Log Recursive smooths in the dB domain for a more natural look at low levels.",
              "kind": "choice",
              "binding": {"phone": "DisplaySpectrumAveraging"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "options": [
                {"value": 0, "label": "None"},
                {"value": 1, "label": "Recursive"},
                {"value": 2, "label": "Time Window"},
                {"value": 3, "label": "Log Recursive"}
              ],
              "default": 3,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumDefaults.averageTime",
              "label": "Spectrum Avg Time:",
              "tooltip": "Spectrum averaging time constant. Larger = heavier smoothing, slower response. Translates to a frame-by-frame alpha via α = exp(−1 / (fps × τ)).",
              "kind": "integer",
              "binding": {"phone": "DisplaySpectrumAverageTimeMs"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "min": 10, "max": 9999, "step": 10, "unit": "ms", "default": 30,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumDefaults.decimation",
              "label": "Decimation:",
              "tooltip": "Display decimation. Higher the number, the lower the resolution.",
              "kind": "integer",
              "binding": {"phone": "decimation"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "min": 1, "max": 16, "step": 1, "default": 1,
              "gate": {"capability": "spectrumGrantVersion", "min": 2}
            },
            {
              "id": "display.spectrumDefaults.panFill",
              "label": "Fill under trace",
              "tooltip": "Check to fill the panadapter display line below the data.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPanFill"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "default": true
            },
            {
              "id": "display.spectrumDefaults.fillAlpha",
              "label": "Fill Alpha:",
              "tooltip": "Opacity of the fill area under the spectrum trace (0 = transparent, 100 = opaque).",
              "kind": "slider",
              "binding": {"phone": "DisplayFftFillAlpha"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "min": 0, "max": 100, "step": 1, "unit": "%", "default": 70
            },
            {
              "id": "display.spectrumDefaults.gradient",
              "label": "Trace gradient",
              "tooltip": "When checked, the spectrum trace line renders with the gradient color applied.",
              "kind": "toggle",
              "binding": {"phone": "DisplayGradientEnabled"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "default": false
            },
            {
              "id": "display.spectrumDefaults.peakHold",
              "label": "Peak hold",
              "tooltip": "When enabled, the highest signal level seen at each frequency bin is held on the display.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPeakHoldEnabled"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "default": false
            },
            {
              "id": "display.spectrumDefaults.peakDelay",
              "label": "Peak Delay:",
              "tooltip": "Time in milliseconds before a held peak begins to decay back toward the live trace.",
              "kind": "integer",
              "binding": {"phone": "DisplayPeakHoldResetMs"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "min": 100, "max": 10000, "step": 100, "unit": "ms", "default": 2000
            }
          ]
        }
      ]
    },
    {
      "id": "display.spectrumPeaks",
      "title": "Spectrum Peaks",
      "where": "phone",
      "coverage": "partial",
      "sections": [
        {
          "title": "Active Peak Hold",
          "controls": [
            {
              "id": "display.spectrumPeaks.activePeakHold",
              "label": "Enable per-bin peak trace with decay",
              "tooltip": "Display a secondary trace of the highest recent level at each frequency bin. Each bin holds its peak for the hold duration after it was last raised, then falls at the drop rate.",
              "kind": "toggle",
              "binding": {"phone": "DisplayActivePeakHoldEnabled"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.activePeakHoldTime",
              "label": "Hold duration:",
              "tooltip": "How long (ms) a peak bin is held at its maximum before starting to decay.",
              "kind": "integer",
              "binding": {"phone": "DisplayActivePeakHoldDurationMs"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "min": 100, "max": 60000, "step": 100, "unit": "ms", "default": 2000,
              "gate": {"capability": "displayExtrasVersion", "min": 3}
            },
            {
              "id": "display.spectrumPeaks.activePeakHoldDropRate",
              "label": "Drop rate:",
              "tooltip": "Rate at which a held peak falls once its hold duration has passed.",
              "kind": "integer",
              "binding": {"phone": "DisplayActivePeakHoldDropDbPerSec"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "min": 1, "max": 60, "step": 1, "unit": "dB/s", "default": 6,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.activePeakHoldFill",
              "label": "Fill area between peak trace and current trace",
              "tooltip": "Shade the region between the live spectrum and the peak-hold trace.",
              "kind": "toggle",
              "binding": {"phone": "DisplayActivePeakHoldFill"},
              "applies": "live",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.activePeakHoldOnTx",
              "label": "Update during TX",
              "tooltip": "Keep the peak trace running while this panadapter transmits. When off, the trace is hidden and paused until transmit ends.",
              "kind": "toggle",
              "binding": {"phone": "DisplayActivePeakHoldOnTx"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 3}
            },
            {
              "id": "display.spectrumPeaks.activePeakHoldColor",
              "label": "Trace color:",
              "tooltip": "Color of the dashed Active Peak Hold trace. Set this to a hue different from the live data-line color so the peak trace stays visible (e.g. after Reset to Smooth Defaults paints the live trace white).",
              "kind": "colour",
              "binding": {"phone": "DisplayActivePeakHoldColor"},
              "applies": "live",
              "requiresDescriptionVersion": 11,
              "default": "#FFD700FF",
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            }
          ]
        },
        {
          "title": "Peak Blobs",
          "controls": [
            {
              "id": "display.spectrumPeaks.peakBlobs",
              "label": "Show top-N peak markers",
              "tooltip": "Display small circle markers at the top-N highest signal peaks in the spectrum.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPeakBlobsEnabled"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobCount",
              "label": "Number of peaks:",
              "tooltip": "Number of peak markers to display (1 to 20).",
              "kind": "integer",
              "binding": {"phone": "DisplayPeakBlobsCount"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "min": 1, "max": 20, "step": 1, "default": 3,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobInsideFilter",
              "label": "Only show peaks inside the RX filter passband",
              "tooltip": "Restrict peak blobs to frequencies within the current RX filter passband.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPeakBlobsInsideFilterOnly"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobHold",
              "label": "Hold peaks before decay",
              "tooltip": "Keep each blob at its peak position for the hold duration before falling.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPeakBlobsHoldEnabled"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobHoldTime",
              "label": "Hold duration:",
              "tooltip": "How long (ms) a blob is held at its peak before falling.",
              "kind": "integer",
              "binding": {"phone": "DisplayPeakBlobsHoldMs"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "min": 100, "max": 60000, "step": 100, "unit": "ms", "default": 500,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobHoldDrop",
              "label": "Decay after hold (off = hard cut)",
              "tooltip": "When on, blobs decay at the fall rate after the hold. When off, blobs disappear instantly after the hold duration.",
              "kind": "toggle",
              "binding": {"phone": "DisplayPeakBlobsHoldDrop"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "default": false,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobFallRate",
              "label": "Fall rate:",
              "tooltip": "Rate at which blobs fall after the hold duration.",
              "kind": "integer",
              "binding": {"phone": "DisplayPeakBlobsFallDbPerSec"},
              "applies": "subscription",
              "requiresDescriptionVersion": 11,
              "min": 1, "max": 60, "step": 1, "unit": "dB/s", "default": 6,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobColor",
              "label": "Blob color:",
              "tooltip": "Color of the peak blob circles.",
              "kind": "colour",
              "binding": {"phone": "DisplayPeakBlobColor"},
              "applies": "live",
              "requiresDescriptionVersion": 11,
              "default": "#FF4500FF",
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.spectrumPeaks.peakBlobTextColor",
              "label": "Text color:",
              "tooltip": "Color of the dBm readout text on each peak blob.",
              "kind": "colour",
              "binding": {"phone": "DisplayPeakBlobTextColor"},
              "applies": "live",
              "requiresDescriptionVersion": 11,
              "default": "#7FFF00FF",
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            }
          ]
        }
      ]
    },
    {
      "id": "display.waterfallDefaults",
      "title": "Waterfall Defaults",
      "where": "phone",
      "coverage": "partial",
      "sections": [
        {
          "title": "Display",
          "controls": [
            {
              "id": "display.waterfallDefaults.detector",
              "label": "WF Detector:",
              "tooltip": "Waterfall bin-reduction policy. Peak takes the maximum bin per pixel. Rosenfell alternates max/min. Average takes the arithmetic mean. Sample takes the first bin.",
              "kind": "choice",
              "binding": {"phone": "DisplayWaterfallDetector"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "options": [
                {"value": 0, "label": "Peak"},
                {"value": 1, "label": "Rosenfell"},
                {"value": 2, "label": "Average"},
                {"value": 3, "label": "Sample"}
              ],
              "default": 0,
              "gate": {"capability": "remoteMediaVersion", "min": 1}
            },
            {
              "id": "display.waterfallDefaults.averaging",
              "label": "WF Averaging:",
              "tooltip": "Waterfall frame-averaging mode. None shows raw FFT output per row. Recursive exponentially smooths in linear power space. Time Window approximates a sliding average. Log Recursive smooths in the dB domain for better low-signal visibility.",
              "kind": "choice",
              "binding": {"phone": "DisplayWaterfallAveraging"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "options": [
                {"value": 0, "label": "None"},
                {"value": 1, "label": "Recursive"},
                {"value": 2, "label": "Time Window"},
                {"value": 3, "label": "Log Recursive"}
              ],
              "default": 0,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.waterfallDefaults.averageTime",
              "label": "WF Avg Time:",
              "tooltip": "Waterfall averaging time constant. Independent from the spectrum averaging time. Larger = heavier smoothing. Translates to a frame-by-frame alpha via α = exp(−1 / (fps × τ)).",
              "kind": "integer",
              "binding": {"phone": "DisplayWaterfallAverageTimeMs"},
              "applies": "subscription",
              "requiresDescriptionVersion": 8,
              "min": 10, "max": 9999, "step": 10, "unit": "ms", "default": 120,
              "gate": {"capability": "displayExtrasVersion", "min": 1}
            },
            {
              "id": "display.waterfallDefaults.updatePeriod",
              "label": "Update Period:",
              "tooltip": "How often to update (scroll another pixel line) on the waterfall display.  Note that this is tamed by the FPS setting.",
              "kind": "slider",
              "binding": {"phone": "DisplayWfUpdatePeriodMs"},
              "applies": "subscription",
              "requiresDescriptionVersion": 9,
              "min": 10, "max": 500, "step": 1, "unit": "ms", "default": 30
            },
            {
              "id": "display.waterfallDefaults.stopOnTx",
              "label": "Stop on TX",
              "tooltip": "Pause the waterfall while transmitting. Resumes automatically when TX ends.",
              "kind": "toggle",
              "binding": {"phone": "WaterfallStopOnTx"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "default": false
            },
            {
              "id": "display.waterfallDefaults.opacity",
              "label": "Opacity:",
              "tooltip": "Waterfall opacity (0 = fully transparent, 100 = fully opaque). Blends the waterfall over the spectrum background.",
              "kind": "slider",
              "binding": {"phone": "DisplayWfOpacity"},
              "applies": "live",
              "requiresDescriptionVersion": 9,
              "min": 0, "max": 100, "step": 1, "unit": "%", "default": 100
            }
          ]
        },
        {
          "title": "Overlays",
          "controls": [
            {
              "id": "display.waterfallDefaults.showRxFilter",
              "label": "Show RX filter on waterfall",
              "tooltip": "Overlay the current RX passband filter boundaries on the waterfall display.",
              "kind": "toggle",
              "binding": {"phone": "DisplayShowRxFilterOnWaterfall"},
              "applies": "live",
              "requiresDescriptionVersion": 10,
              "default": false
            },
            {
              "id": "display.waterfallDefaults.showTxFilter",
              "label": "Show TX filter on RX waterfall",
              "tooltip": "Overlay the TX passband filter boundaries on the RX waterfall display.",
              "kind": "toggle",
              "binding": {"phone": "DisplayShowTxFilterOnRxWaterfall"},
              "applies": "live",
              "requiresDescriptionVersion": 10,
              "default": true
            },
            {
              "id": "display.waterfallDefaults.showRxZeroLine",
              "label": "Show RX zero line on waterfall",
              "tooltip": "Draw a line on the waterfall at the RX center frequency (zero-beat reference).",
              "kind": "toggle",
              "binding": {"phone": "DisplayShowRxZeroLine"},
              "applies": "live",
              "requiresDescriptionVersion": 10,
              "default": false
            },
            {
              "id": "display.waterfallDefaults.showTxZeroLine",
              "label": "Show TX zero line on waterfall",
              "tooltip": "Draw a line on the waterfall at the TX center frequency (zero-beat reference).",
              "kind": "toggle",
              "binding": {"phone": "DisplayShowTxZeroLine"},
              "applies": "live",
              "requiresDescriptionVersion": 10,
              "default": false
            }
          ]
        }
      ]
    },
    {
      "id": "display.multimeter",
      "title": "Multimeter",
      "where": "mixed",
      "coverage": "partial",
      "sections": [
        {
          "title": "Multimeter",
          "controls": [
            {
              "id": "display.multimeter.pollingDelay",
              "label": "Polling delay:",
              "tooltip": "How often the meter values are updated (10–2000 ms). Lower values give faster response; higher values reduce CPU load.",
              "kind": "integer",
              "binding": {
                "setting": "MultimeterDelayMs"
              },
              "applies": "live",
              "min": 10,
              "max": 2000,
              "step": 1,
              "unit": "ms",
              "default": 100
            }
          ]
        }
      ]
    },
    {
      "id": "display.txDisplay",
      "title": "TX Display",
      "where": "mixed",
      "coverage": "partial",
      "sections": [
        {
          "title": "Fast Fourier Transform",
          "controls": [
            {
              "id": "display.txDisplay.fftSize",
              "label": "Size",
              "tooltip": "TX FFT size used during MOX. Range 4096 to 262144 in powers of two. Larger gives finer frequency resolution and a smaller bin width at higher CPU cost. RX FFT slider is independent.",
              "kind": "slider",
              "binding": {
                "setting": "DisplayTxFftSize"
              },
              "applies": "live",
              "requiresDescriptionVersion": 4,
              "options": [
                {
                  "value": 4096,
                  "label": "4096"
                },
                {
                  "value": 8192,
                  "label": "8192"
                },
                {
                  "value": 16384,
                  "label": "16384"
                },
                {
                  "value": 32768,
                  "label": "32768"
                },
                {
                  "value": 65536,
                  "label": "65536"
                },
                {
                  "value": 131072,
                  "label": "131072"
                },
                {
                  "value": 262144,
                  "label": "262144"
                }
              ],
              "default": 32768,
              "gate": {
                "capability": "txDisplayVersion",
                "min": 2
              }
            },
            {
              "id": "display.txDisplay.window",
              "label": "Window",
              "tooltip": "TX FFT window function. Hamming (default) trades a wide main lobe for moderate sidelobe rejection. Blackman-Harris (4T or 7T) gives strong sidelobe rejection for cleaner waterfall during TX. Flat-Top is best for amplitude calibration. Kaiser is parameterized.",
              "kind": "choice",
              "binding": {
                "setting": "DisplayTxWindowType"
              },
              "applies": "live",
              "choices": [
                "Rectangular",
                "Blackman-Harris 4T",
                "Hann",
                "Flat-Top",
                "Hamming",
                "Kaiser",
                "Blackman-Harris 7T"
              ],
              "default": 4,
              "gate": {
                "capability": "txDisplayVersion",
                "min": 2
              }
            }
          ]
        },
        {
          "title": "Panadapter",
          "controls": [
            {
              "id": "display.txDisplay.panDetector",
              "label": "Detector:",
              "tooltip": "TX panadapter trace detector. Peak shows the maximum bin value per pixel (transient-friendly). Average integrates across the bins (smoother). Sample takes one bin per pixel. RMS is true root-mean-square. Normalize is only available for Average / Sample / RMS.",
              "kind": "choice",
              "binding": {
                "setting": "DisplayTxPanDetector"
              },
              "applies": "live",
              "choices": [
                "Peak",
                "Rosenfell",
                "Average",
                "Sample",
                "RMS"
              ],
              "default": 0,
              "gate": {
                "capability": "txDisplayVersion",
                "min": 2
              }
            },
            {
              "id": "display.txDisplay.panAveraging",
              "label": "Averaging:",
              "tooltip": "TX panadapter trace averaging policy. None = instantaneous. Recursive = exponential smoothing with the time constant set below. Time Window = fixed-window N-frame average. Log Recursive = recursive in the log (dBm) domain.",
              "kind": "choice",
              "binding": {
                "setting": "DisplayTxPanAveraging"
              },
              "applies": "live",
              "choices": [
                "None",
                "Recursive",
                "Time Window",
                "Log Recursive"
              ],
              "default": 0,
              "gate": {
                "capability": "txDisplayVersion",
                "min": 2
              }
            },
            {
              "id": "display.txDisplay.panAvTime",
              "label": "Time:",
              "tooltip": "TX panadapter averaging time constant in milliseconds. Larger values give smoother traces at the cost of slower response to transients.",
              "kind": "integer",
              "binding": {
                "setting": "DisplayTxPanAvTimeMs"
              },
              "applies": "live",
              "min": 1,
              "max": 9999,
              "step": 1,
              "unit": "ms",
              "default": 30,
              "gate": {
                "capability": "txDisplayVersion",
                "min": 2
              }
            },
            {
              "id": "display.txDisplay.panNormalize",
              "label": "1 Hz BW: Av / Sa",
