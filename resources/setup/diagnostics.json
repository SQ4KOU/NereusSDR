{
  "version": 3,
  "category": {
    "id": "diagnostics",
    "title": "Diagnostics",
    "where": "station",
    "coverage": "partial"
  },
  "pages": [{
    "id": "diagnostics.settingsValidation",
    "title": "Settings Validation",
    "where": "station",
    "coverage": "partial",
    "sections": [{
      "title": "Validation Issues",
      "controls": [{
        "id": "diagnostics.settingsValidation.health",
        "label": "Validation Issues",
        "tooltip": "",
        "kind": "settingsHygiene",
        "requiresDescriptionVersion": 3,
        "binding": {"settingsHygiene": {"version": 1}},
        "applies": "live",
        "gate": {"capability": "settingsHygieneVersion", "min": 1},
        "actions": [
          {"id": "validate", "label": "Re-validate"},
          {"id": "repair", "label": "Repair Invalid Settings", "paired": true,
           "offAir": true,
           "gate": {"capability": "settingsHygieneVersion", "min": 2},
           "reason": "Repair invalid settings is not available on this Core. Updating the Core may help.",
           "confirmation": {"title": "Repair Settings",
                            "message": "Repair the settings that are invalid for this radio?",
                            "default": "cancel"}},
          {"id": "forget", "label": "Forget This Radio", "paired": true,
           "offAir": true,
           "confirmation": {"title": "Forget Radio",
                            "message": "Forget all settings for this radio?",
                            "default": "cancel"}}
        ]
      }]
    }]
  }]
}
